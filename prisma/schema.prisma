// Inner Garden — Prisma schema
// PostgreSQL. List fields use native array type for simplicity and good Prisma support.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ——— Seeds: daily structured reflections (one per day) ———
model Seed {
  id           String   @id @default(cuid())
  date         DateTime @db.Date
  energyLevel  Int?
  tendingToday String[] @default([])
  release      String[] @default([])
  assumptions  String[] @default([])
  bodyCheckIn  String[] @default([])
  notes        String[] @default([])
  tags         String[] @default([])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([date])
  @@index([date])
}

// ——— Weeks: main reflection container (weekStart = Monday or Sunday, your choice) ———
model Week {
  id               String    @id @default(cuid())
  weekStart        DateTime  @db.Date
  strengthenedMe   String[]  @default([])
  drainedMe        String[]  @default([])
  patternsNoticed  String[]  @default([])
  reflections      String[]  @default([])
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  blossoms         Blossom[]

  @@unique([weekStart])
  @@index([weekStart])
}

// ——— Blossoms: insights created from within a Week ———
model Blossom {
  id          String    @id @default(cuid())
  weekId      String
  week        Week      @relation(fields: [weekId], references: [id], onDelete: Cascade)
  title       String
  description String?
  priority    Boolean   @default(false)
  status      BlossomStatus @default(active)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([weekId])
  @@index([status])
}

enum BlossomStatus {
  active
  completed
}

// ——— Cycle: settings + period-start history (Phase 1) ———
model CycleSettings {
  id                  String   @id @default("default")
  lastPeriodStart     DateTime @db.Date
  defaultCycleLength  Int      @default(28)
  defaultPeriodLength Int      @default(5)
  updatedAt           DateTime @updatedAt
}

model PeriodStart {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  createdAt DateTime @default(now())

  @@unique([date])
  @@index([date])
}

// ——— JournalEntry: cycle-aware daily journal (one per day) ———
model JournalEntry {
  id                String   @id @default(cuid())
  date              DateTime @db.Date
  body              String   @default("")
  energy            String[] @default([])
  mood              String[] @default([])
  bodySensations    String[] @default([])
  themes            String[] @default([])
  cycleDay          Int?
  cyclePhase        String?
  cycleDayOverride  Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([date])
  @@index([date])
}
